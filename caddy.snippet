# Snippet für /opt/appdata/caddy/Caddyfile auf Hetzner.
#
# Unten an die zentrale Caddyfile anhängen und reloaden:
#   docker compose -f /opt/appdata/caddy/docker-compose.yml exec caddy \
#     caddy reload --config /etc/caddy/Caddyfile
#
# Voraussetzungen:
#   - Caddy-Container am externen Docker-Netz `proxy`
#   - DNS A-Record tab.vrwb.de -> Hetzner-Host
#   - Upstreams sind die EXPLIZITEN container_name-Werte aus docker-compose.prod.yml
#     (keine generischen Aliase — Routing-Bug-Falle im geteilten proxy-Netz!)

tab.vrwb.de {
    import hsts
    encode zstd gzip

    # Sicherheits-Header (Audit 2026-11-08, LIVE-06); CSP nur für die Oberfläche, nicht für API/Belege.
    # data: bei font-src: Vite bettet kleine Schriftdateien als data:-URL ein. Neue externe Quellen hier freigeben
    # UND auf der Datenschutzseite nennen.
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # API ans Backend
    @api path /api/* /api
    handle @api {
        reverse_proxy tab-backend:8000
    }

    # Alles andere -> SPA (statisches Nginx im Frontend-Container)
    handle {
        header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self' blob:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        reverse_proxy tab-frontend:80
    }

    log {
        # Datenschutz (tab.vrwb.de/datenschutz): täglich rotieren, nach 7 Tagen löschen
        output file /var/log/caddy/tab.vrwb.de.log {
            roll_interval 1d
            roll_keep 7
            roll_keep_for 7d
        }
        format json
    }
}
